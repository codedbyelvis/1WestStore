---
// 1. Get the current pathname (e.g., "/", "/products", "/admin", etc.)
const pathname = Astro.url.pathname;

// 2. Determine if the user is in the Keystatic admin area
// (Assuming your admin is hosted at a path starting with /admin)
const isAdmin = pathname.startsWith('/admin');
---

<nav>
  {isAdmin ? (
    <!-- SET 1: Links for the Keystatic Admin panel -->
    <div class="nav-links">
      <a href="/admin">Dashboard</a>
      <a href="/admin/content/products">Manage Products</a>
      <a href="/" target="_blank">View Live Store ↗</a>
    </div>
  ) : (
    <!-- SET 2: Links for your Public Online Store -->
    <div class="nav-links">
      <a href="/">Store</a>
      <a href="/cart">Cart</a>
      <a href="/suggestion/">Suggestions</a>
      <a href="/admin">Admin Login</a>
    </div>
  )}
</nav>