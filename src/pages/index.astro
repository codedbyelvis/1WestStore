---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';

const pageTitle = "1-West Store";

// 1. Load all product JSON files directly using Vite's import.meta.glob
const productFiles = import.meta.glob('/src/content/products/**/*.json', { eager: true });

// Convert the imported module object into a clean array of product data along with their file slugs
const allProducts = Object.entries(productFiles).map(([filepath, file]: [string, any]) => {
  const productData = file.default || file;
  
  // Extract the exact filename as the slug (e.g., "test3" from "/src/content/products/test3.json")
  const slug = filepath.split('/').pop()?.replace(/\.json$/, '') || '';

  return {
    slug,
    data: productData.data || productData
  };
});

// Fetch the store settings singleton (or fallback gracefully if it fails)
let categories = ['Test'];
try {
  const settings = await getEntry('storeSettings', 'index');
  if (settings?.data?.categoryOrder) {
    categories = settings.data.categoryOrder;
  }
} catch (e) {
  console.log("Using default categories");
}
---

<BaseLayout pageTitle={pageTitle}>
  {categories.map((category) => {
    const matchingProducts = allProducts.filter((p: any) => {
      // Handle both direct properties or .data structure depending on how glob loads it
      const productData = p.data;
      const allProductTags = [
        ...(productData.presetTags || []),
        ...(productData.customTags || [])
      ];
      return allProductTags.some((tag) => tag.toLowerCase() === category.toLowerCase());
    });

    return (
      <section style="margin-bottom: 2rem;">
        <h2>{category.toUpperCase()}</h2>
        
        {matchingProducts.length === 0 ? (
          <p>No products found in this category.</p>
        ) : (
          <div class="product-grid">
            {matchingProducts.map((p: any) => {
              const product = p.data;
              const fileSlug = p.slug; // Extract the true file slug for the cart button
              
              return (
                <div class="card">
                  {product.image?.file && (
                    <img 
                      src={product.image.file} 
                      alt={product.image?.alt || product.title} 
                      class="card-image" 
                    />
                  )}
                  <div class="card-body">
                    <h3>{product.title}</h3>
                    <p>{product.description}</p>
                    <div class="price">${product.price}</div>
                  </div>
                  <button 
                    type="button" 
                    class="btn cart-btn" 
                    data-title={product.title} 
                    data-price={product.price} 
                    data-image={product.image?.file}
                    data-slug={fileSlug}
                  >
                    Add to Cart
                  </button>
                </div>
              );
            })}
          </div>
        )}
      </section>
    );
  })}
</BaseLayout>