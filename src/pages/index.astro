---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';

const pageTitle = "Home Page";

// 1. Load all product JSON files directly using Vite's import.meta.glob
const productFiles = import.meta.glob('/src/content/products/**/*.json', { eager: true });

// Convert the imported module object into a clean array of product data
const allProducts = Object.values(productFiles).map((file: any) => {
  return file.default || file;
});

// Fetch the store settings singleton (or fallback gracefully if it fails)
let categories = ['Test'];
try {
  const settings = await getEntry('storeSettings', 'index');
  if (settings?.data?.categoryOrder) {
    categories = settings.data.categoryOrder;
  }
} catch (e) {
  console.log("Using default categories");
}
---

<BaseLayout pageTitle={pageTitle}>
  {categories.map((category) => {
    const matchingProducts = allProducts.filter((p: any) => {
      const allProductTags = [
        ...(p.presetTags || []),
        ...(p.customTags || [])
      ];
      return allProductTags.some((tag) => tag.toLowerCase() === category.toLowerCase());
    });

    return (
      <section style="margin-bottom: 2rem;">
        <h2>{category.toUpperCase()}</h2>
        
        {matchingProducts.length === 0 ? (
          <p>No products found in this category.</p>
        ) : (
          <ul>
            {matchingProducts.map((product: any) => (
              <li>
                <h3>{product.title}</h3>
                <p>{product.description}</p>
                <p>Price: ${product.price}</p>
              </li>
            ))}
          </ul>
        )}
      </section>
    );
  })}
</BaseLayout>
